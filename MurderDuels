-- ======================== HELPERS ========================
local function getChar()
    return LocalPlayer.Character
end

local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function isAliveChar(char)
    if not char or not char.Parent then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    return hum ~= nil and hrp ~= nil and hum.Health > 0
end

local function isEnemyPlayer(plr)
    if not plr or plr == LocalPlayer then return false end
    if not isAliveChar(plr.Character) then return false end
    if S.TeamCheck then
        local myTeamAttr = LocalPlayer:GetAttribute("Team") or LocalPlayer:GetAttribute("TeamId")
        local thrTeamAttr = plr:GetAttribute("Team") or plr:GetAttribute("TeamId")
        if myTeamAttr ~= nil and thrTeamAttr ~= nil and tostring(myTeamAttr) == tostring(thrTeamAttr) then
            return false
        end
        if LocalPlayer.Team and plr.Team and LocalPlayer.Team == plr.Team then
            return false
        end
    end
    return true
end

local function getAimPoint(char)
    if not char then return nil end
    return char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
end

local function isVisible(fromPos, targetPart)
    if not S.WallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent, Camera}
    params.IgnoreWater = true
    local ok, hit = pcall(function()
        return Workspace:Raycast(fromPos, targetPart.Position - fromPos, params)
    end)
    if not ok then return true end
    return hit == nil or hit.Instance:IsDescendantOf(targetPart.Parent)
end

local function getAimCenter()
    if IsMobile then
        local vp = Camera.ViewportSize
        return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    end
    return UserInputService:GetMouseLocation()
end

local function getBestTarget(maxRadius)
    local bestPart = nil
    local bestDist = maxRadius or S.FOV
    local center = getAimCenter()
    local camPos = Camera.CFrame.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if isEnemyPlayer(plr) then
            local part = getAimPoint(plr.Character)
            if part then
                local scr, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and scr.Z > 0 then
                    local d2 = (Vector2.new(scr.X, scr.Y) - center).Magnitude
                    if d2 < bestDist and isVisible(camPos, part) then
                        bestDist = d2
                        bestPart = part
                    end
                end
            end
        end
    end
    return bestPart
end

