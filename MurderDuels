		hit.Position = UDim2.new(0, 0, 0, -7)
		hit.BackgroundTransparency = 1
		hit.Text = ""
		hit.AutoButtonColor = false
		hit.ZIndex = 16

		local val = math.clamp(initialVal, 0, 255)
		local function setCh(v, fire)
			val = math.clamp(math.floor(v + 0.5), 0, 255)
			fill.Size = UDim2.new(val / 255, 0, 1, 0)
			lbl.Text = string.format("%s: %d", chName, val)
			if fire and onChChange then
				onChChange(val)
			end
		end

		local drag = false
		local function updatePos(px)
			local ax = bg.AbsolutePosition.X
			local aw = math.max(bg.AbsoluteSize.X, 1)
			setCh(255 * math.clamp((px - ax) / aw, 0, 1), true)
		end

		hit.InputBegan:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				drag = true
				updatePos(inp.Position.X)
				inp.Changed:Connect(function()
					if inp.UserInputState == Enum.UserInputState.End then drag = false end
				end)
			end
		end)

		UserInputService.InputChanged:Connect(function(inp)
			if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
				updatePos(inp.Position.X)
			end
		end)

		setCh(val, false)
		return function(v) setCh(v, false) end
	end

	local function pushRGB()
		Config.RainbowMenu = false
		local c = Color3.fromRGB(Config.CustomRGB.R, Config.CustomRGB.G, Config.CustomRGB.B)
		previewSwatch.BackgroundColor3 = c
		applyAccentSmooth(c, false, false)
	end

	local setR = makeChannelRow(28, "Red (R)", Config.CustomRGB.R, Color3.fromRGB(255, 59, 48), function(v)
		Config.CustomRGB.R = v
		pushRGB()
	end)
	local setG = makeChannelRow(68, "Green (G)", Config.CustomRGB.G, Color3.fromRGB(48, 209, 88), function(v)
		Config.CustomRGB.G = v
		pushRGB()
	end)
	local setB = makeChannelRow(108, "Blue (B)", Config.CustomRGB.B, Color3.fromRGB(10, 132, 255), function(v)
		Config.CustomRGB.B = v
		pushRGB()
	end)

	rgbSyncCallbacks.MainRGB = function(r, g, b)
		setR(r)
		setG(g)
		setB(b)
		previewSwatch.BackgroundColor3 = Color3.fromRGB(r, g, b)
	end
end

