UserInputService.InputChanged:Connect(function(inp)
    if not dragState then return end
    if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
        local d = inp.Position - dragState.start
        if dragState.kind == "win" then
            win.Position = UDim2.new(dragState.origin.X.Scale, dragState.origin.X.Offset + d.X, dragState.origin.Y.Scale, dragState.origin.Y.Offset + d.Y)
        elseif dragState.kind == "btn" then
            if d.Magnitude > 8 then dragState.moved = true end
            if dragState.moved then
                local nx = math.clamp(dragState.origin.X.Offset + d.X, 8, math.max(8, Camera.ViewportSize.X - floatBtn.AbsoluteSize.X - 8))
                local ny = math.clamp(dragState.origin.Y.Offset + d.Y, 8, math.max(8, Camera.ViewportSize.Y - floatBtn.AbsoluteSize.Y - 8))
                floatBtn.Position = UDim2.new(0, nx, 0, ny)
            end
        elseif dragState.kind == "slider" and dragState.fn then
            dragState.fn(inp.Position.X)
        end
    end
end)

UserInputService.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
