local function ensureFly(hrp)
	if not hrp then return end
	if not flyBodyVel or not flyBodyVel.Parent then
		flyBodyVel = Instance.new("BodyVelocity")
		flyBodyVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		flyBodyVel.Velocity = Vector3.zero
		flyBodyVel.Parent = hrp
	end
	if not flyBodyGyro or not flyBodyGyro.Parent then
		flyBodyGyro = Instance.new("BodyGyro")
		flyBodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		flyBodyGyro.P = 1e4
		flyBodyGyro.CFrame = Camera.CFrame
		flyBodyGyro.Parent = hrp
	end
end

local function getFlyMoveVector(hum)
	local moveDir = hum and hum.MoveDirection or Vector3.zero
	if moveDir.Magnitude > 0.05 then
		local camLook = Camera.CFrame.LookVector
		local camRight = Camera.CFrame.RightVector
		local forwardDot = moveDir:Dot(Vector3.new(camLook.X, 0, camLook.Z).Unit)
		local rightDot = moveDir:Dot(Vector3.new(camRight.X, 0, camRight.Z).Unit)
		local vec = (Camera.CFrame.LookVector * forwardDot) + (Camera.CFrame.RightVector * rightDot)
		return vec.Magnitude > 0 and vec.Unit or Vector3.zero
	end
	return Vector3.zero
end

local function getCrosshair()
	if IsMobile then
		return Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.45)
	end
	local mousePos = UserInputService:GetMouseLocation()
	return Vector2.new(mousePos.X, mousePos.Y)
end

local function isPartVisible(origin, targetPart, targetChar)
	if not Config.WallCheck then return true end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = {}
	if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
	if targetChar then table.insert(filter, targetChar) end
	params.FilterDescendantsInstances = filter

	local res = Workspace:Raycast(origin, targetPart.Position - origin, params)
	return res == nil
end

local function getBestMurderTarget(crosshair)
	local murder = getMurderer()
	if not murder or not murder.Character then return nil end

	local char = murder.Character
	local hum = char:FindFirstChildOfClass("Humanoid")
	local part = (Config.AimbotHitbox == "HumanoidRootPart")
		and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
		or (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))

	if not hum or not part or hum.Health <= 0 then return nil end

	local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
	if screenPos.Z > 0 and onScreen then
		local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - crosshair).Magnitude
		if dist2D <= Config.AimbotFOV and isPartVisible(Camera.CFrame.Position, part, char) then
			return part
		end
	end
	return nil
end

