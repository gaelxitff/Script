local lastThemeTick = 0
local lastGunScanTick = 0
local lastGunDrawTick = 0
local lastStatsTick = 0
local fpsFrames = 0
local fpsAccum = 0
local currentFPS = 60

refreshGunCache()

_G.MonsterRenderConn = RunService.RenderStepped:Connect(function(dt)
	Camera = Workspace.CurrentCamera or Camera
	if not Camera then return end

	local now = os.clock()
	glassGrad.Rotation = (now * 14) % 360

	fpsFrames += 1
	fpsAccum += (dt or 0)
	if fpsAccum >= 0.5 then
		currentFPS = math.clamp(math.floor((fpsFrames / fpsAccum) + 0.5), 1, 999)
		fpsFrames = 0
		fpsAccum = 0
	end

	if Config.AliveCounterEnabled and (now - lastStatsTick) >= 0.25 then
		lastStatsTick = now
		TopStatsPill.Visible = true
		statsPillLabel.Text = string.format("ALIVE: %d  •  %d FPS", countAlivePlayers(), currentFPS)
	elseif not Config.AliveCounterEnabled then
		TopStatsPill.Visible = false
	end

	local offsets = { Murder = 0.0, Sheriff = 0.33, Innocent = 0.66 }
	for rKey, vis in pairs(roleLiveVisuals) do
		if vis and vis.rainbowGetter() then
			local rCol = getRainbowColor(1.4, offsets[rKey] or 0)
			if vis.swatch and vis.swatch.Parent then vis.swatch.BackgroundColor3 = rCol end
			if vis.stroke and vis.stroke.Parent then vis.stroke.Color = rCol end
		end
	end

	if Config.RainbowMenu and (now - lastThemeTick) >= 0.12 then
		lastThemeTick = now
		applyAccentSmooth(getRainbowColor(1.5, 0), false, true)
	end

	if (now - lastGunScanTick) >= 0.85 then
		lastGunScanTick = now
		pcall(refreshGunCache)
	end

	if (now - lastGunDrawTick) >= 0.15 then
		lastGunDrawTick = now
		pcall(updateGunVisuals)
	end

	local myChar = LocalPlayer.Character
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

	if myHum and myHum.Health > 0 then
		if Config.SpeedEnabled then
			myHum.WalkSpeed = Config.WalkSpeedValue
		end
		if Config.JumpBoostEnabled then
			myHum.UseJumpPower = true
			myHum.JumpPower = Config.JumpPowerValue
		end
	end

	if Config.FlyEnabled and myHum and myHRP and myHum.Health > 0 then
		ensureFly(myHRP)
		local moveVec = getFlyMoveVector(myHum)
		flyBodyVel.Velocity = moveVec * Config.FlySpeed
		flyBodyGyro.CFrame = Camera.CFrame
	else
		stopFly()
	end

	if Config.ESPEnabled then
		for _, player in ipairs(Players:GetPlayers()) do
			pcall(applyESP, player)
		end
	else
		for player in pairs(boxDrawings) do
			hideBox(player)
		end
	end

	if HasDrawing and Config.TracersEnabled then
		local topOrigin = Vector2.new(Camera.ViewportSize.X * 0.5, 0)
		local trColor = Config.TracerRainbow and getRainbowColor(1.2, 0.25) or Config.TracerColor

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local hum = player.Character:FindFirstChildOfClass("Humanoid")
				local anchor = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
				local _, roleCol = getRole(player)
				local lineColor = Config.RoleBasedColors and roleCol or trColor

				if hum and anchor and hum.Health > 0 then
					local screenPos, onScreen = Camera:WorldToViewportPoint(anchor.Position)
					if screenPos.Z > 0 and onScreen then
						local line = tracers[player]
						if not line then
							line = Drawing.new("Line")
							line.Thickness = 1.8
							line.Transparency = 0.9
							tracers[player] = line
						end
						line.From = topOrigin
						line.To = Vector2.new(screenPos.X, screenPos.Y)
						line.Color = lineColor
						line.Visible = true
					elseif tracers[player] then
						tracers[player].Visible = false
					end
				elseif tracers[player] then
					tracers[player].Visible = false
				end
			elseif tracers[player] then
				tracers[player].Visible = false
			end
		end
	elseif HasDrawing then
		for _, line in pairs(tracers) do
			line.Visible = false
		end
	end

	if Config.BigHeadEnabled then
		local hSize = Vector3.new(Config.HeadSize, Config.HeadSize, Config.HeadSize)
		local hColor = Config.HeadRainbow and getRainbowColor(1.2, 0.5) or Config.HeadColor

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local head = player.Character:FindFirstChild("Head")
				if head and head:IsA("BasePart") then
					if not originalHeads[head] then
						originalHeads[head] = {
							Size = head.Size,
							Color = head.Color,
							Transparency = head.Transparency,
							CanCollide = head.CanCollide,
							Massless = head.Massless
						}
					end
					pcall(function()
						head.Size = hSize
						head.Color = hColor
						head.Transparency = 0.45
						head.CanCollide = false
						head.Massless = true
					end)
				end
			end
		end
	end

	local crosshair = getCrosshair()
	local locked = false
	local canAim = not Config.OnlyWhenSheriff or hasTool(LocalPlayer, "Gun") or hasTool(LocalPlayer, "Revolver")

	if Config.AimbotEnabled and canAim and myChar then
		local targetPart = getBestMurderTarget(crosshair)
		if targetPart then
			locked = true
			local goalCF = CFrame.new(Camera.CFrame.Position, targetPart.Position)
			Camera.CFrame = Camera.CFrame:Lerp(goalCF, Config.AimbotSmooth)
		end
	end

	if fovCircle then
		if Config.AimbotEnabled and Config.ShowFOV then
			fovCircle.Position = crosshair
			fovCircle.Radius = Config.AimbotFOV
			fovCircle.Color = locked and Color3.fromRGB(255, 255, 255) or Config.AccentColor
			fovCircle.Visible = true
		else
			fovCircle.Visible = false
		end
	end
end)

