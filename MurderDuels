RunService.RenderStepped:Connect(function()
    if Workspace.CurrentCamera then Camera = Workspace.CurrentCamera end
    local center = getAimCenter()

    fovRing.Position = UDim2.new(0, center.X, 0, center.Y)
    fovRing.Size = UDim2.new(0, S.FOV * 2, 0, S.FOV * 2)
    fovStroke.Color = getRainbow(0)
    fovRing.Visible = S.ShowFOV and S.Aimbot

    if S.Aimbot and (S.AlwaysOn or HoldingAim) then
        local target = getBestTarget(S.FOV)
        if target then
            local goal = CFrame.lookAt(Camera.CFrame.Position, target.Position)
            Camera.CFrame = Camera.CFrame:Lerp(goal, S.Smoothness)
        end
    end

    updateEspAndChams()
    updateHitboxes()
    updateMovement()
end)

