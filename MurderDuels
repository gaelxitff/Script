local function applyAccentSmooth(col, instant, syncRGB)
	Config.AccentColor = col
	if fovCircle and not Config.AimbotEnabled then
		fovCircle.Color = col
	end

	if syncRGB then
		Config.CustomRGB.R = math.floor((col.R * 255) + 0.5)
		Config.CustomRGB.G = math.floor((col.G * 255) + 0.5)
		Config.CustomRGB.B = math.floor((col.B * 255) + 0.5)
		for _, fn in pairs(rgbSyncCallbacks) do
			pcall(fn, Config.CustomRGB.R, Config.CustomRGB.G, Config.CustomRGB.B)
		end
	end

	for _, st in ipairs(accentStrokes) do
		if st and st.Parent then
			if instant then
				st.Color = col
			else
				pcall(function()
					TweenService:Create(st, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingOut), { Color = col }):Play()
				end)
			end
		end
	end

	for _, fr in ipairs(accentHighlights) do
		if fr and fr.Parent then
			if instant then
				fr.BackgroundColor3 = col
			else
				pcall(function()
					TweenService:Create(fr, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingOut), { BackgroundColor3 = col }):Play()
				end)
			end
		end
	end

	local activeBtn = tabButtons[currentTabName]
	if activeBtn and activeBtn.Parent then
		if instant then
			activeBtn.BackgroundColor3 = col
		else
			pcall(function()
				TweenService:Create(activeBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingOut), { BackgroundColor3 = col }):Play()
			end)
		end
	end
end

local function applyMenuAlpha(alpha)
	Config.MenuTransparency = math.clamp(alpha, 0, 0.85)
	for _, cont in ipairs(transparentContainers) do
		if cont and cont.Parent then
			local offset = (cont == MainFrame) and 0 or 0.07
			pcall(function()
				TweenService:Create(cont, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingOut), {
					BackgroundTransparency = math.clamp(Config.MenuTransparency + offset, 0, 0.92)
				}):Play()
			end)
		end
	end
end

