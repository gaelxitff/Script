	statusLbl.ZIndex = 11

	local function animateToColor(newCol, presetName)
		setterFn(newCol)
		pcall(function()
			TweenService:Create(swatch, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingOut), { BackgroundColor3 = newCol }):Play()
			TweenService:Create(cStroke, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingOut), { Color = newCol }):Play()
		end)
		if presetName then
			notifyIOS(roleTitle .. " Color", presetName)
		end
	end

	local function refreshRainbowUI()
		local active = rainbowGetter()
		rainbowBtn.BackgroundColor3 = active and Color3.fromRGB(48, 209, 88) or Color3.fromRGB(52, 52, 62)
		statusLbl.Text = active and "Mode: Rainbow automático" or "Mode: Color fijo"
