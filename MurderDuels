local function getRainbowColor(speed)
	speed = speed or 1
	local hue = (os.clock() * speed * 0.22) % 1
	return Color3.fromHSV(hue, 1, 1)
end

local function setRayfieldVisible(visible)
	menuVisible = visible
	local root = getRayfieldRoot()
	if not root then return end

	for _, child in ipairs(root:GetChildren()) do
		if child:IsA("ScreenGui") or child:IsA("Frame") then
			if child ~= floatGui then
				pcall(function()
					child.Enabled = visible
				end)
				if child:IsA("Frame") then
					pcall(function()
						child.Visible = visible
					end)
				end
			end
		elseif child:IsA("GuiObject") and child ~= floatGui then
			pcall(function()
				child.Visible = visible
			end)
		end
	end
end

