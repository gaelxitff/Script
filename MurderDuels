			pcall(function()
				TweenService:Create(cont, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingOut), {
					BackgroundTransparency = math.clamp(Config.MenuTransparency + offset, 0, 0.92)
				}):Play()
			end)
		end
	end
end

