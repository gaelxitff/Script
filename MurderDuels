local function animateMenuColor(targetColor)
	Config.MenuAccent = targetColor
	if fovCircle and not Config.AimbotEnabled then
		fovCircle.Color = targetColor
	end

	if floatGui then
		for _, obj in ipairs(floatGui:GetDescendants()) do
			if obj:IsA("UIStroke") then
				pcall(function()
					TweenService:Create(obj, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingOut), {
						Color = targetColor
					}):Play()
				end)
			end
		end
	end

	local root = getRayfieldRoot()
	if not root then return end

	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("UIStroke") then
			pcall(function()
				TweenService:Create(obj, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingOut), {
					Color = targetColor
				}):Play()
			end)
		elseif obj:IsA("Frame") then
			local sz = obj.Size
			if (sz.X.Offset > 0 and sz.X.Offset <= 14) or (sz.Y.Offset > 0 and sz.Y.Offset <= 6) then
				if obj.BackgroundColor3 ~= Color3.fromRGB(25, 25, 25) and obj.BackgroundColor3 ~= Color3.fromRGB(30, 30, 30) then
					pcall(function()
						TweenService:Create(obj, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingOut), {
							BackgroundColor3 = targetColor
						}):Play()
					end)
				end
			end
		end
	end
end

local function applyMenuTransparency(alpha)
	Config.MenuTransparency = math.clamp(alpha, 0, 0.85)
	local root = getRayfieldRoot()
	if not root then return end

	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
			if obj.BackgroundTransparency < 0.95 then
				pcall(function()
					TweenService:Create(obj, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingOut), {
						BackgroundTransparency = math.clamp(Config.MenuTransparency + (obj.BackgroundTransparency * 0.15), 0, 0.9)
					}):Play()
				end)
			end
		end
	end
end

-- Roles MM2
local function hasTool(player, toolName)
	if not player then return false end
	local char = player.Character
	local bp = player:FindFirstChild("Backpack")
	return (char and char:FindFirstChild(toolName) ~= nil)
		or (bp and bp:FindFirstChild(toolName) ~= nil)
end

local function getRole(player)
	if hasTool(player, "Knife") then
		return "Murder", Config.ColorMurder
	elseif hasTool(player, "Gun") or hasTool(player, "Revolver") then
		return "Sheriff", Config.ColorSheriff
	end
	return "Innocent", Config.ColorInnocent
end

local function getMurderer()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and hasTool(p, "Knife") then
			return p
		end
	end
	return nil
end

-- Gun caída
local function isInsidePlayer(inst)
	local cur = inst.Parent
	while cur and cur ~= Workspace do
		if cur:IsA("Backpack") or Players:GetPlayerFromCharacter(cur) then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function hasWeaponName(name)
	if type(name) ~= "string" then return false end
	local low = string.lower(name)
	return low:find("gun", 1, true) ~= nil
		or low:find("revolver", 1, true) ~= nil
		or low:find("pistol", 1, true) ~= nil
end

local function getGunTarget(obj)
	if not obj or not obj.Parent or isInsidePlayer(obj) then return nil, nil end
	if obj:IsA("Tool") and hasWeaponName(obj.Name) then
		local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
		if handle then return handle, obj end
	elseif hasWeaponName(obj.Name) then
		if obj:IsA("Model") then
			local p = obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
			if p and p:FindFirstChildWhichIsA("TouchTransmitter", true) then
				return p, obj
			end
		elseif obj:IsA("BasePart") and obj:FindFirstChildWhichIsA("TouchTransmitter", true) then
			return obj, obj
		end
	end
	return nil, nil
end

local function clearGunVisuals()
	for obj, hl in pairs(gunHighlights) do
		if hl then pcall(function() hl:Destroy() end) end
		gunHighlights[obj] = nil
	end
	for obj, tag in pairs(gunTags) do
		if tag then pcall(function() tag:Destroy() end) end
		gunTags[obj] = nil
	end
	if gunTracerLine then
		gunTracerLine.Visible = false
	end
end

local function updateGunESP()
	if not Config.GunESPEnabled then
		clearGunVisuals()
		return
	end

	local found = {}
	for _, desc in ipairs(Workspace:GetDescendants()) do
		local part, adornee = getGunTarget(desc)
		if part and adornee then
			table.insert(found, { obj = desc, part = part, adornee = adornee })
		end
	end

	for obj, hl in pairs(gunHighlights) do
		local valid = false
		for _, item in ipairs(found) do
			if item.obj == obj then valid = true break end
		end
		if not valid then
			if hl then pcall(function() hl:Destroy() end) end
			gunHighlights[obj] = nil
		end
	end

	for obj, tag in pairs(gunTags) do
		local valid = false
		for _, item in ipairs(found) do
			if item.obj == obj then valid = true break end
		end
		if not valid then
			if tag then pcall(function() tag:Destroy() end) end
			gunTags[obj] = nil
		end
	end

	if #found == 0 then
		if gunTracerLine then gunTracerLine.Visible = false end
		return
	end

	for i, item in ipairs(found) do
		if not gunHighlights[item.obj] or not gunHighlights[item.obj].Parent then
			local hl = Instance.new("Highlight")
			hl.Name = "MonsterGunCham"
			hl.Adornee = item.adornee
			hl.FillColor = Config.GunFillColor
			hl.FillTransparency = 0.15
			hl.OutlineColor = Config.GunOutlineColor
			hl.OutlineTransparency = 0
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = CoreGui
			gunHighlights[item.obj] = hl
		end

		if not gunTags[item.obj] or not gunTags[item.obj].Parent then
			local bb = Instance.new("BillboardGui")
			bb.Name = "MonsterGunTag"
			bb.Adornee = item.part
			bb.Size = UDim2.new(0, 96, 0, 22)
			bb.StudsOffset = Vector3.new(0, 1.5, 0)
			bb.AlwaysOnTop = true
			bb.Parent = CoreGui

			local lbl = Instance.new("TextLabel", bb)
			lbl.Size = UDim2.new(1, 0, 1, 0)
			lbl.BackgroundColor3 = Config.GunFillColor
			lbl.BackgroundTransparency = 0.2
			lbl.Text = "🔫 GUN"
			lbl.TextColor3 = Config.GunOutlineColor
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 12
			Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 6)

			local stroke = Instance.new("UIStroke", lbl)
			stroke.Color = Config.GunOutlineColor
			stroke.Thickness = 1

			gunTags[item.obj] = bb
		end

		if i == 1 and HasDrawing and Config.GunTracerEnabled and gunTracerLine then
			local pos, onScreen = Camera:WorldToViewportPoint(item.part.Position)
			if pos.Z > 0 and onScreen then
				gunTracerLine.From = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y)
				gunTracerLine.To = Vector2.new(pos.X, pos.Y)
				gunTracerLine.Color = Config.GunOutlineColor
				gunTracerLine.Visible = true
			else
				gunTracerLine.Visible = false
			end
		end
	end
end

-- ESP Jugadores
local function removeESP(player)
	if highlights[player] then
		pcall(function() highlights[player]:Destroy() end)
		highlights[player] = nil
	end
	if nameTags[player] then
		pcall(function() nameTags[player]:Destroy() end)
		nameTags[player] = nil
	end
end

local function applyESP(player)
	if player == LocalPlayer or not Config.ESPEnabled then
		removeESP(player)
		return
	end

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")

	if not char or not hum or not hrp or hum.Health <= 0 then
		removeESP(player)
		return
	end

	local roleName, roleColor = getRole(player)
	local activeColor = Config.ESPRainbow and getRainbowColor(1.2)
		or (Config.RoleBasedColors and roleColor or Config.ESPColor)

	local hl = highlights[player]
	if not hl or not hl.Parent or hl.Adornee ~= char then
		if hl then pcall(function() hl:Destroy() end) end
		hl = Instance.new("Highlight")
		hl.Name = "MonsterPlayerHighlight"
		hl.Adornee = char
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillTransparency = 0.55
		hl.OutlineTransparency = 0.1
		hl.Parent = CoreGui
		highlights[player] = hl
	end
	hl.FillColor = activeColor
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)

	if (Config.ESPNames or Config.ESPRole or Config.ESPDistance) and head then
		local tag = nameTags[player]
		if not tag or not tag.Parent or tag.Adornee ~= head then
			if tag then pcall(function() tag:Destroy() end) end
			tag = Instance.new("BillboardGui")
			tag.Name = "MonsterPlayerTag"
			tag.Adornee = head
			tag.Size = UDim2.new(0, 180, 0, 26)
			tag.StudsOffset = Vector3.new(0, 2.2, 0)
			tag.AlwaysOnTop = true
			tag.Parent = CoreGui

			local lbl = Instance.new("TextLabel", tag)
			lbl.Name = "Label"
			lbl.Size = UDim2.new(1, 0, 1, 0)
			lbl.BackgroundTransparency = 1
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 12
			lbl.TextStrokeTransparency = 0.35
			nameTags[player] = tag
		end

		local lbl = tag:FindFirstChild("Label")
		local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local dist = myHRP and math.floor((myHRP.Position - hrp.Position).Magnitude) or 0

		local info = {}
		if Config.ESPNames then table.insert(info, player.DisplayName) end
		if Config.ESPRole then table.insert(info, "[" .. roleName .. "]") end
		if Config.ESPDistance then table.insert(info, dist .. "m") end

		if lbl then
			lbl.Text = table.concat(info, " ")
			lbl.TextColor3 = activeColor
		end
	elseif nameTags[player] then
		pcall(function() nameTags[player]:Destroy() end)
		nameTags[player] = nil
	end
end

local function clearTracers()
	for player, tr in pairs(tracers) do
		if tr then pcall(function() tr:Remove() end) end
		tracers[player] = nil
	end
end

local function restoreHeads()
	for headPart, data in pairs(originalHeads) do
		if headPart and headPart.Parent then
			pcall(function()
				headPart.Size = data.Size
				headPart.Color = data.Color
				headPart.Transparency = data.Transparency
				headPart.CanCollide = data.CanCollide
				headPart.Massless = data.Massless
			end)
		end
		originalHeads[headPart] = nil
	end
end

-- Noclip & Fly
local function restoreNoclip()
	for part, oldCollide in pairs(noclipParts) do
		if part and part.Parent then
			pcall(function() part.CanCollide = oldCollide end)
		end
		noclipParts[part] = nil
	end
end

local function stopFly()
	if flyBodyVel then
		pcall(function() flyBodyVel:Destroy() end)
		flyBodyVel = nil
	end
	if flyBodyGyro then
		pcall(function() flyBodyGyro:Destroy() end)
		flyBodyGyro = nil
	end
end

local function ensureFly(hrp)
	if not hrp then return end
	if not flyBodyVel or not flyBodyVel.Parent then
		flyBodyVel = Instance.new("BodyVelocity")
		flyBodyVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		flyBodyVel.Velocity = Vector3.zero
		flyBodyVel.Parent = hrp
	end
	if not flyBodyGyro or not flyBodyGyro.Parent then
		flyBodyGyro = Instance.new("BodyGyro")
		flyBodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		flyBodyGyro.P = 1e4
		flyBodyGyro.CFrame = Camera.CFrame
		flyBodyGyro.Parent = hrp
	end
end

local function getFlyMoveVector(hum)
	local moveDir = hum and hum.MoveDirection or Vector3.zero
	if moveDir.Magnitude > 0.05 then
		local camLook = Camera.CFrame.LookVector
		local camRight = Camera.CFrame.RightVector
		local forwardDot = moveDir:Dot(Vector3.new(camLook.X, 0, camLook.Z).Unit)
		local rightDot = moveDir:Dot(Vector3.new(camRight.X, 0, camRight.Z).Unit)
		local vec = (Camera.CFrame.LookVector * forwardDot) + (Camera.CFrame.RightVector * rightDot)
		return vec.Magnitude > 0 and vec.Unit or Vector3.zero
	end
	return Vector3.zero
end

-- Aimbot helpers
local function getCrosshair()
	if IsMobile then
		return Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.45)
	end
	local mousePos = UserInputService:GetMouseLocation()
	return Vector2.new(mousePos.X, mousePos.Y)
end

local function isPartVisible(origin, targetPart, targetChar)
	if not Config.WallCheck then return true end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = {}
	if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
	if targetChar then table.insert(filter, targetChar) end
	params.FilterDescendantsInstances = filter

	local res = Workspace:Raycast(origin, targetPart.Position - origin, params)
	return res == nil
end

local function getBestMurderTarget(crosshair)
	local murder = getMurderer()
	if not murder or not murder.Character then return nil end

	local char = murder.Character
	local hum = char:FindFirstChildOfClass("Humanoid")
	local part = (Config.AimbotHitbox == "HumanoidRootPart")
		and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
		or (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))

	if not hum or not part or hum.Health <= 0 then return nil end

	local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
	if screenPos.Z > 0 and onScreen then
		local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - crosshair).Magnitude
		if dist2D <= Config.AimbotFOV and isPartVisible(Camera.CFrame.Position, part, char) then
			return part
		end
	end
	return nil
end

