		gunHighlights[obj] = nil
	end
	for obj, tag in pairs(gunTags) do
		if tag then pcall(function() tag:Destroy() end) end
		gunTags[obj] = nil
	end
	if gunTracerLine then
		gunTracerLine.Visible = false
	end
end

local function updateGunESP()
	if not Config.GunESPEnabled then
		clearGunVisuals()
		return
	end

	local found = {}
	for _, desc in ipairs(Workspace:GetDescendants()) do
		local part, adornee = getGunTarget(desc)
		if part and adornee then
			table.insert(found, { obj = desc, part = part, adornee = adornee })
		end
	end

	for obj, hl in pairs(gunHighlights) do
		local valid = false
		for _, item in ipairs(found) do
			if item.obj == obj then valid = true break end
		end
		if not valid then
			if hl then pcall(function() hl:Destroy() end) end
			gunHighlights[obj] = nil
		end
	end

	for obj, tag in pairs(gunTags) do
		local valid = false
		for _, item in ipairs(found) do
			if item.obj == obj then valid = true break end
		end
		if not valid then
			if tag then pcall(function() tag:Destroy() end) end
			gunTags[obj] = nil
		end
	end

	if #found == 0 then
		if gunTracerLine then gunTracerLine.Visible = false end
		return
	end

	for i, item in ipairs(found) do
		if not gunHighlights[item.obj] or not gunHighlights[item.obj].Parent then
			local hl = Instance.new("Highlight")
			hl.Name = "MonsterIOS_GunCham"
			hl.Adornee = item.adornee
			hl.FillColor = Config.GunFillColor
			hl.FillTransparency = 0.15
			hl.OutlineColor = Config.GunOutlineColor
			hl.OutlineTransparency = 0
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = CoreGui
			gunHighlights[item.obj] = hl
		end

		if not gunTags[item.obj] or not gunTags[item.obj].Parent then
			local bb = Instance.new("BillboardGui")
			bb.Name = "MonsterIOS_GunTag"
			bb.Adornee = item.part
			bb.Size = UDim2.new(0, 96, 0, 22)
			bb.StudsOffset = Vector3.new(0, 1.5, 0)
			bb.AlwaysOnTop = true
			bb.Parent = CoreGui

			local lbl = Instance.new("TextLabel", bb)
			lbl.Size = UDim2.new(1, 0, 1, 0)
			lbl.BackgroundColor3 = Config.GunFillColor
			lbl.BackgroundTransparency = 0.2
			lbl.Text = "🔫 GUN"
			lbl.TextColor3 = Config.GunOutlineColor
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 12
			Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 8)

			local stroke = Instance.new("UIStroke", lbl)
			stroke.Color = Config.GunOutlineColor
			stroke.Thickness = 1

			gunTags[item.obj] = bb
		end

		if i == 1 and HasDrawing and Config.GunTracerEnabled and gunTracerLine then
			local pos, onScreen = Camera:WorldToViewportPoint(item.part.Position)
			if pos.Z > 0 and onScreen then
				gunTracerLine.From = Vector2.new(Camera.ViewportSize.X * 0.5, 0)
				gunTracerLine.To = Vector2.new(pos.X, pos.Y)
				gunTracerLine.Color = Config.GunOutlineColor
				gunTracerLine.Visible = true
			else
				gunTracerLine.Visible = false
			end
		end
	end
end

-- ESP Box 2D (Drawing)
local function ensureBox(player)
	if not HasDrawing then return nil end
	if boxDrawings[player] then return boxDrawings[player] end

	local outline = Drawing.new("Square")
	outline.Thickness = 3
	outline.Filled = false
	outline.Color = Color3.fromRGB(0, 0, 0)
	outline.Transparency = 0.65
	outline.Visible = false

	local box = Drawing.new("Square")
	box.Thickness = 1.6
	box.Filled = false
	box.Transparency = 0.95
	box.Visible = false

	local entry = { outline = outline, box = box }
	boxDrawings[player] = entry
	return entry
end

local function hideBox(player)
	local entry = boxDrawings[player]
	if entry then
		if entry.outline then entry.outline.Visible = false end
		if entry.box then entry.box.Visible = false end
	end
end

local function removeBox(player)
	local entry = boxDrawings[player]
	if entry then
		if entry.outline then pcall(function() entry.outline:Remove() end) end
		if entry.box then pcall(function() entry.box:Remove() end) end
		boxDrawings[player] = nil
	end
end

local function updateBoxESP(player, char, hum, hrp, head, activeColor)
	if not HasDrawing or not Config.ESPEnabled or not Config.BoxESPEnabled then
		hideBox(player)
		return
	end

	local entry = ensureBox(player)
	if not entry then return end

	local rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
	local topPos = Camera:WorldToViewportPoint((head.CFrame * CFrame.new(0, 0.85, 0)).Position)
	local bottomPos = Camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0, -3.1, 0)).Position)

	if not onScreen or rootPos.Z <= 0 or topPos.Z <= 0 or bottomPos.Z <= 0 then
		hideBox(player)
		return
	end

	local height = math.clamp(math.abs(bottomPos.Y - topPos.Y), 10, Camera.ViewportSize.Y * 0.9)
	local width = math.clamp(height * 0.56, 8, Camera.ViewportSize.X * 0.6)
	local pos = Vector2.new(rootPos.X - (width * 0.5), topPos.Y)
	local size = Vector2.new(width, height)

	entry.outline.Position = pos
	entry.outline.Size = size
	entry.outline.Visible = true

	entry.box.Position = pos
	entry.box.Size = size
	entry.box.Color = activeColor
	entry.box.Visible = true
end

-- ESP Jugadores (Highlight + Tag + Box)
local function removeESP(player)
	if highlights[player] then
		pcall(function() highlights[player]:Destroy() end)
		highlights[player] = nil
	end
	if nameTags[player] then
		pcall(function() nameTags[player]:Destroy() end)
		nameTags[player] = nil
	end
	removeBox(player)
end

local function applyESP(player)
	if player == LocalPlayer or not Config.ESPEnabled then
		removeESP(player)
		return
	end

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")

	if not char or not hum or not hrp or not head or hum.Health <= 0 then
		removeESP(player)
		return
	end

	local roleName, roleColor = getRole(player)
	local activeColor = Config.ESPRainbow and getRainbowColor(1.2)
		or (Config.RoleBasedColors and roleColor or Config.ESPColor)

	local hl = highlights[player]
	if not hl or not hl.Parent or hl.Adornee ~= char then
		if hl then pcall(function() hl:Destroy() end) end
		hl = Instance.new("Highlight")
		hl.Name = "MonsterIOS_Highlight"
		hl.Adornee = char
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillTransparency = 0.58
		hl.OutlineTransparency = 0.1
		hl.Parent = CoreGui
		highlights[player] = hl
	end
	hl.FillColor = activeColor
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)

	updateBoxESP(player, char, hum, hrp, head, activeColor)

	if (Config.ESPNames or Config.ESPRole or Config.ESPDistance) then
		local tag = nameTags[player]
		if not tag or not tag.Parent or tag.Adornee ~= head then
			if tag then pcall(function() tag:Destroy() end) end
			tag = Instance.new("BillboardGui")
			tag.Name = "MonsterIOS_Tag"
			tag.Adornee = head
			tag.Size = UDim2.new(0, 185, 0, 26)
			tag.StudsOffset = Vector3.new(0, 2.2, 0)
			tag.AlwaysOnTop = true
			tag.Parent = CoreGui

			local lbl = Instance.new("TextLabel", tag)
			lbl.Name = "Label"
			lbl.Size = UDim2.new(1, 0, 1, 0)
			lbl.BackgroundTransparency = 1
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 12
			lbl.TextStrokeTransparency = 0.35
			nameTags[player] = tag
		end

		local lbl = tag:FindFirstChild("Label")
		local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local dist = myHRP and math.floor((myHRP.Position - hrp.Position).Magnitude) or 0

		local info = {}
		if Config.ESPNames then table.insert(info, player.DisplayName) end
		if Config.ESPRole then table.insert(info, "[" .. roleName .. "]") end
		if Config.ESPDistance then table.insert(info, dist .. "m") end

		if lbl then
			lbl.Text = table.concat(info, " ")
			lbl.TextColor3 = activeColor
		end
	elseif nameTags[player] then
		pcall(function() nameTags[player]:Destroy() end)
		nameTags[player] = nil
	end
end

