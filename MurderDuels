local function addSlider(page, labelText, minVal, maxVal, initial, suffix, onChanged)
	local box = Instance.new("Frame", page)
	box.Size = UDim2.new(1, 0, 0, 46)
	box.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
	box.BackgroundTransparency = 0.14
	box.ZIndex = 3
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 12)

	local title = Instance.new("TextLabel", box)
	title.Size = UDim2.new(1, -18, 0, 18)
	title.Position = UDim2.new(0, 12, 0, 4)
	title.BackgroundTransparency = 1
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Font = Enum.Font.GothamMedium
	title.TextSize = 11
	title.TextColor3 = Color3.fromRGB(235, 235, 240)
	title.ZIndex = 4

	local barBg = Instance.new("Frame", box)
	barBg.Size = UDim2.new(1, -24, 0, 7)
	barBg.Position = UDim2.new(0, 12, 0, 29)
	barBg.BackgroundColor3 = Color3.fromRGB(58, 58, 68)
	barBg.ZIndex = 4
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

	local barFill = Instance.new("Frame", barBg)
	barFill.Size = UDim2.new(0, 0, 1, 0)
	barFill.BackgroundColor3 = Config.AccentColor
	barFill.ZIndex = 5
	Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)
	table.insert(accentHighlights, barFill)

	local current = math.clamp(initial, minVal, maxVal)

	local function setNumeric(val, fire)
		current = math.clamp(math.floor(val + 0.5), minVal, maxVal)
		local ratio = (current - minVal) / math.max(maxVal - minVal, 1)
		barFill.Size = UDim2.new(ratio, 0, 1, 0)
		title.Text = string.format("%s: %d%s", labelText, current, suffix or "")
		if fire and onChanged then
			onChanged(current)
		end
	end

	local sliding = false
	local function updateFromInput(posX)
		local absX = barBg.AbsolutePosition.X
		local absW = math.max(barBg.AbsoluteSize.X, 1)
		local r = math.clamp((posX - absX) / absW, 0, 1)
		setNumeric(minVal + (maxVal - minVal) * r, true)
	end

	barBg.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateFromInput(inp.Position.X)
			inp.Changed:Connect(function()
				if inp.UserInputState == Enum.UserInputState.End then sliding = false end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(inp)
		if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(inp.Position.X)
		end
	end)

	setNumeric(current, false)
	return setNumeric
end

