local function makeSlider(page, text, minV, maxV, step, defV, suffix, onChanged)
    local cur = defV or minV
    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 0, 46)
    box.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    box.BackgroundTransparency = 0.91
    box.BorderSizePixel = 0
    box.ZIndex = 46
    box.Parent = page

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 13)
    bc.Parent = box

    local top = Instance.new("TextLabel")
    top.Position = UDim2.new(0, 12, 0, 5)
    top.Size = UDim2.new(1, -24, 0, 17)
    top.BackgroundTransparency = 1
    top.Text = string.format("%s: %s%s", text, tostring(cur), suffix or "")
    top.TextColor3 = Color3.fromRGB(242, 248, 255)
    top.Font = Enum.Font.GothamMedium
    top.TextSize = 11.5
    top.TextXAlignment = Enum.TextXAlignment.Left
    top.ZIndex = 47
    top.Parent = box

    local track = Instance.new("Frame")
    track.Position = UDim2.new(0, 12, 0, 28)
    track.Size = UDim2.new(1, -24, 0, 7)
    track.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    track.BackgroundTransparency = 0.82
    track.BorderSizePixel = 0
    track.ZIndex = 47
    track.Parent = box

    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(1, 0)
    tc.Parent = track

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(math.clamp((cur - minV) / math.max(maxV - minV, 1), 0, 1), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(80, 195, 255)
    fill.BorderSizePixel = 0
    fill.ZIndex = 48
    fill.Parent = track

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local function applyX(px)
        local ratio = math.clamp((px - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        local raw = minV + (maxV - minV) * ratio
        cur = math.clamp(math.floor((raw / step) + 0.5) * step, minV, maxV)
        fill.Size = UDim2.new((cur - minV) / math.max(maxV - minV, 1), 0, 1, 0)
        top.Text = string.format("%s: %s%s", text, tostring(cur), suffix or "")
        if onChanged then onChanged(cur) end
    end

    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            applyX(inp.Position.X)
            dragState = {kind = "slider", fn = applyX}
        end
    end)
end

