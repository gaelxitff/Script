-- ======================== ESP ARCOÍRIS ========================
local function removeEsp(plr)
    local c = espCache[plr]
    if not c then return end
    pcall(function()
        c.box:Destroy()
        c.tracer:Destroy()
        c.label:Destroy()
    end)
    espCache[plr] = nil
end

local function ensureEsp(plr)
    if espCache[plr] then return espCache[plr] end

    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.Visible = false
    box.Active = false
    box.ZIndex = 12
    box.Parent = espLayer

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = IsMobile and 2 or 1.6
    stroke.Parent = box

    local tracer = Instance.new("Frame")
    tracer.AnchorPoint = Vector2.new(0.5, 0.5)
    tracer.BorderSizePixel = 0
    tracer.Visible = false
    tracer.Active = false
    tracer.ZIndex = 11
    tracer.Parent = espLayer

    local label = Instance.new("TextLabel")
    label.AnchorPoint = Vector2.new(0.5, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.TextStrokeTransparency = 0.25
    label.Visible = false
    label.Active = false
    label.ZIndex = 13
    label.Parent = espLayer

    local entry = {box = box, stroke = stroke, tracer = tracer, label = label}
    espCache[plr] = entry
    return entry
end

local function drawLineFrame(frame, a, b, col, thick)
    local dx = b.X - a.X
    local dy = b.Y - a.Y
    local dist = math.sqrt(dx * dx + dy * dy)
    if dist < 1 then
        frame.Visible = false
        return
    end
    frame.Position = UDim2.new(0, (a.X + b.X) * 0.5, 0, (a.Y + b.Y) * 0.5)
    frame.Size = UDim2.new(0, dist, 0, thick)
    frame.Rotation = math.deg(math.atan2(dy, dx))
    frame.BackgroundColor3 = col
    frame.Visible = true
end

local function updateEspAndChams()
    local myHRP = getHRP()
    local vp = Camera.ViewportSize
    local originBottom = Vector2.new(vp.X * 0.5, vp.Y)
    local idx = 0

    for _, plr in ipairs(Players:GetPlayers()) do
        idx += 1
        local rbCol = getRainbow(idx * 0.17)

        if not S.ESP or not isEnemyPlayer(plr) then
            removeEsp(plr)
            if chamsCache[plr] then
                pcall(function() chamsCache[plr]:Destroy() end)
                chamsCache[plr] = nil
            end
            continue
        end

        local char = plr.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = getAimPoint(char)
        if not (hrp and head) then
            removeEsp(plr)
            continue
        end

        local dist3D = myHRP and (hrp.Position - myHRP.Position).Magnitude or 0
        if dist3D > S.MaxDist then
            removeEsp(plr)
            continue
        end

        if S.Chams then
            local hl = chamsCache[plr]
            if not hl or not hl.Parent then
                hl = Instance.new("Highlight")
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.FillTransparency = 0.55
                hl.OutlineTransparency = 0.15
                hl.Parent = char
                chamsCache[plr] = hl
            end
            hl.FillColor = rbCol
            hl.OutlineColor = getRainbow((idx * 0.17) + 0.35)
        elseif chamsCache[plr] then
            pcall(function() chamsCache[plr]:Destroy() end)
            chamsCache[plr] = nil
        end

        local entry = ensureEsp(plr)
        local topScr, topOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.55, 0))
        local botScr, botOn = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.0, 0))
        local rootScr, rootOn = Camera:WorldToViewportPoint(hrp.Position)

        if S.BoxESP and (topOn or botOn) and rootScr.Z > 0 then
            local h = math.clamp(math.abs(botScr.Y - topScr.Y), 16, 360)
            local w = math.clamp(h * 0.56, 12, 240)
            entry.box.Size = UDim2.new(0, w, 0, h)
            entry.box.Position = UDim2.new(0, rootScr.X - w * 0.5, 0, math.min(topScr.Y, botScr.Y))
            entry.stroke.Color = rbCol
            entry.box.Visible = true
        else
            entry.box.Visible = false
        end

        if S.Tracers and rootOn and rootScr.Z > 0 then
            drawLineFrame(entry.tracer, originBottom, Vector2.new(rootScr.X, rootScr.Y), rbCol, IsMobile and 2 or 1.5)
        else
            entry.tracer.Visible = false
        end

        if S.NameESP and topOn and topScr.Z > 0 then
            entry.label.Text = string.format("%s [%dm]", plr.DisplayName, math.floor(dist3D))
            entry.label.TextColor3 = rbCol
            entry.label.Position = UDim2.new(0, topScr.X, 0, math.max(12, topScr.Y - 4))
            entry.label.Visible = true
        else
            entry.label.Visible = false
        end
    end
end

-- ======================== HITBOX & MOVIMIENTO ========================
local function updateHitboxes()
    if not S.HitboxExpand then
        for plr, parts in pairs(origSizes) do
            if plr.Character then
                for pName, sz in pairs(parts) do
                    local p = plr.Character:FindFirstChild(pName)
                    if p and p:IsA("BasePart") then
                        p.Size = sz
                        p.Transparency = 0
                    end
                end
            end
        end
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if isEnemyPlayer(plr) and plr.Character then
            origSizes[plr] = origSizes[plr] or {}
            for _, pName in ipairs({"Head", "HumanoidRootPart"}) do
                local p = plr.Character:FindFirstChild(pName)
                if p and p:IsA("BasePart") then
                    if not origSizes[plr][pName] then
                        origSizes[plr][pName] = p.Size
                    end
                    p.Size = Vector3.new(S.HitboxSize, S.HitboxSize, S.HitboxSize)
                    p.Transparency = 0.72
                    p.CanCollide = false
                end
            end
        end
    end
end

local function updateMovement()
    local char = getChar()
    local hum = getHum()
    local hrp = getHRP()
    if not (char and hum and hrp) then return end

    if S.Speed then
        hum.WalkSpeed = S.WalkSpeed
    end

    if S.Noclip then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then d.CanCollide = false end
        end
    end

    if S.Fly then
        if not flyBV or not flyBV.Parent then
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            flyBV.Parent = hrp
        end
        if not flyBG or not flyBG.Parent then
            flyBG = Instance.new("BodyGyro")
            flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            flyBG.P = 9e4
            flyBG.Parent = hrp
        end
        flyBG.CFrame = Camera.CFrame
        local moveDir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end
        flyBV.Velocity = moveDir.Magnitude > 0 and moveDir.Unit * S.FlySpeed or Vector3.zero
    end
end

